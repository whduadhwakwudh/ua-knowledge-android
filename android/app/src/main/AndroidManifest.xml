<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!--
      No permission additions are required beyond INTERNET (declared below):
      - APK downloads land in the app-private Directory.Data (context
        getFilesDir()), so no storage permission is needed on any Android API
        level (file-transfer / filesystem plugins);
      - opening the downloaded APK goes through
        @capacitor-community/file-opener, whose FileOpenerProvider (authority
        `<applicationId>.file.opener.provider`) merges from the plugin manifest
        and covers the internal files dir;
      - the local UaFileHash plugin only reads app-private files.
      Install confirmation is the system package installer's ACTION_VIEW flow;
      this app never requests silent install.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Files transfer: moving downloaded files into the public Downloads
      folder. API 29+ uses MediaStore.Downloads (scoped storage, no
      permission needed); API 24-28 writes directly and needs this runtime
      permission (requested on demand by the UaFileStore plugin).
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      Download completion notifications on Android 13+ (API 33) require this
      runtime permission; requested on demand by the UaFileStore plugin.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Installing a downloaded APK requires this permission on Android 8+
      (API 26+): without it the system package installer silently ignores the
      ACTION_VIEW intent and no confirmation dialog appears. The user must
      also allow "install unknown apps" for this app in system settings on
      first use (Android prompts for that on first install request).
      This app only ever uses the system installer confirmation — never a
      silent install API.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
